# ──────────────────────────────────────────────
# Sociala Money — environment variables
# Copy to .env.local for development.
# Never commit real secrets.
# ──────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Supabase (anon key is safe to expose; service_role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Future payment / money-movement providers ──
# Leave empty until the matching integration is implemented.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Future telecom / digital-service providers ──
AIRTIME_PROVIDER_API_KEY=
ESIM_PROVIDER_API_KEY=
VIRTUAL_NUMBERS_PROVIDER_API_KEY=

# ── Future crypto / cards ──
CRYPTO_PROVIDER_API_KEY=
CARD_ISSUER_API_KEY=

# ── Observability (optional) ──
SENTRY_DSN=
